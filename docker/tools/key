#!/bin/bash
# Press key combination, optionally activating a specific window first
# Usage: key <combo>
#        key --window <pid> <wx> <wy> <ww> <wh> -- <combo>
#
# Examples:
#   key Return
#   key ctrl+a
#   key alt+F4
#   key shift+Tab
#   key --window 1234 100 100 800 600 -- ctrl+Tab

set -euo pipefail

# Parse optional --window flag
if [ "${1:-}" = "--window" ]; then
  if [ "$#" -lt 7 ]; then
    echo "Usage: key --window <pid> <wx> <wy> <ww> <wh> -- <combo>" >&2
    exit 1
  fi
  WIN_PID="$2"
  WIN_X="$3"
  WIN_Y="$4"
  WIN_W="$5"
  WIN_H="$6"
  shift 6
  # Skip the -- separator if present
  if [ "${1:-}" = "--" ]; then
    shift
  fi

fi

if [ -z "${1:-}" ]; then
  echo "Usage: key <combo>" >&2
  echo "       key --window <pid> <wx> <wy> <ww> <wh> -- <combo>" >&2
  echo "Examples: Return, ctrl+a, alt+F4, shift+Tab" >&2
  exit 1
fi

COMBO="$1"

# Return is handled against the already-focused chat child window. Activating
# the top-level frame here can move focus away from the editor in new WeChat.
if [ "$COMBO" != "Return" ] && [ -n "${WIN_PID:-}" ]; then
  SCRIPT_DIR="$(dirname "$0")"
  "$SCRIPT_DIR/window-activate" "$WIN_PID" "$WIN_X" "$WIN_Y" "$WIN_W" "$WIN_H" >/dev/null || {
    echo "Warning: could not activate window" >&2
  }
fi

if [ "$COMBO" = "Return" ]; then
  SEND_COORDS=$(a11y-dump --format json 2>/dev/null | python3 -c '
import json, sys
tree = json.load(sys.stdin)
def walk(node):
    if node.get("role") == "push-button" and node.get("name") == "Send(S)" and "DISABLED" not in (node.get("states") or []):
        b = node.get("bounds") or {}
        print("{:.0f} {:.0f}".format(b.get("x", 0) + b.get("width", 0) / 2, b.get("y", 0) + b.get("height", 0) / 2))
        return True
    return any(walk(child) for child in node.get("children") or [])
walk(tree)
' 2>/dev/null || true)
  if [ -n "$SEND_COORDS" ]; then
    read -r SEND_X SEND_Y <<< "$SEND_COORDS"
    xdotool mousemove "$SEND_X" "$SEND_Y" click 1
  else
    xdotool key "$COMBO"
  fi
else
  xdotool key "$COMBO"
fi
echo "pressed: $COMBO"
