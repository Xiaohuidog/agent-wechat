#!/bin/bash
# Paste a file URI into WeChat while preserving the file's original basename.
# Usage: paste-file <file-path>

set -euo pipefail

if [ -z "${1:-}" ]; then
  echo "Usage: paste-file <file-path>" >&2
  exit 1
fi

FILE="$1"
if [ ! -f "$FILE" ]; then
  echo "File not found: $FILE" >&2
  exit 1
fi

ABS_PATH="$(realpath "$FILE")"
# A URI must contain ASCII percent escapes for Unicode and reserved characters.
# Qt decodes it back to the original path under the UTF-8 process locale.
FILE_URI="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).as_uri(), end="")' "$ABS_PATH")"

# xclip serves the selection in the background until WeChat consumes it.
printf '%s' "$FILE_URI" | xclip -selection clipboard -t text/uri-list >/dev/null 2>&1 &
sleep 0.1
xdotool key ctrl+v
sleep 0.1

echo "pasted file: $ABS_PATH"
