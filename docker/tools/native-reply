#!/usr/bin/env python3
"""Native WeChat quote sending. Source IDs are strings; uncertain sends never repeat."""
import ctypes
import ctypes.util
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET


class ReplyError(Exception):
    pass


def query(path, pragmas, sql):
    result = subprocess.run(['sqlcipher', '-readonly', str(path)],
                            input='.mode json\n' + pragmas + '\n' + sql + '\n',
                            text=True, capture_output=True, timeout=25)
    if result.returncode:
        raise ReplyError('REPLY_SOURCE_READ_FAILED')
    output = result.stdout.strip()
    groups = []
    while '[' in output:
        start = output.index('[')
        value, used = json.JSONDecoder().raw_decode(output[start:])
        groups.append(value)
        output = output[start + used:].lstrip()
    return [r for r in (groups[-1] if groups else []) if 'ok' not in r]


def decode_body(value):
    data = bytes.fromhex(value)
    if data.startswith(bytes.fromhex('28b52ffd')):
        lib = ctypes.CDLL(ctypes.util.find_library('zstd'))
        lib.ZSTD_getFrameContentSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
        lib.ZSTD_getFrameContentSize.restype = ctypes.c_ulonglong
        size = lib.ZSTD_getFrameContentSize(data, len(data))
        if not 0 < size <= 2_000_000:
            raise ReplyError('REPLY_SOURCE_FORMAT_UNSUPPORTED')
        dest = ctypes.create_string_buffer(size)
        lib.ZSTD_decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t,
                                      ctypes.c_void_p, ctypes.c_size_t]
        lib.ZSTD_decompress.restype = ctypes.c_size_t
        n = lib.ZSTD_decompress(dest, size, data, len(data))
        if n > size:
            raise ReplyError('REPLY_SOURCE_FORMAT_UNSUPPORTED')
        data = dest.raw[:n]
    body = data.decode('utf-8', errors='replace')
    return re.sub(r'^[^\n]+:\n', '', body, count=1)


def reference(body):
    match = re.search(r'<refermsg>.*?</refermsg>', body, re.S)
    if not match:
        return None
    root = ET.fromstring(match.group())
    return {k: root.findtext(k) for k in ['svrid', 'content', 'type']}


def display_body(row):
    body = row['body']
    if row['type'] == 1:
        return body
    if row['type'] == 49:
        try:
            root = ET.fromstring(body[body.index('<'):])
            return root.findtext('.//appmsg/title') or root.findtext('title')
        except (ValueError, ET.ParseError):
            return None
    return None


def row_matches(row, name):
    expected = display_body(row)
    if expected is None:
        return True  # Media rows are never used as identity anchors.
    if row['type'] == 1:
        return name == expected
    ref = reference(row['body'])
    if ref:
        return name.startswith(expected + '\nQuote ') and name.endswith(
            "'s message: " + (ref['content'] or ''))
    return name == expected


def source_node(rows, visible, local_id):
    """Accept only a unique mapping of the visible ordered rows to database IDs."""
    source = next(r for r in rows if r['local_id'] == local_id)
    candidates = [i for i, n in enumerate(visible) if n['name'] == source['body']]
    if not candidates:
        return None
    # Unique body in the complete chat is unambiguous, including older history.
    if sum(r['type'] == 1 and r['body'] == source['body'] for r in rows) == 1:
        return visible[candidates[0]] if len(candidates) == 1 else None
    placements = []
    for start in range(len(rows) - len(visible) + 1):
        if all(row_matches(rows[start + i], n['name']) for i, n in enumerate(visible)):
            placements.append(start)
    if len(placements) != 1:
        raise ReplyError('REPLY_SOURCE_AMBIGUOUS')
    offset = next(i for i, r in enumerate(rows) if r['local_id'] == local_id) - placements[0]
    if 0 <= offset < len(visible) and offset in candidates:
        return visible[offset]
    return None


def flatten(node):
    yield node
    for child in node.get('children', []):
        yield from flatten(child)


def tree():
    result = subprocess.run(['/opt/tools/a11y-dump'], capture_output=True,
                            text=True, timeout=20, check=True)
    return json.loads(result.stdout)


def click(node, button=1, x_offset=None):
    b = node['bounds']
    x = round(b['x'] + (b['width'] / 2 if x_offset is None else x_offset))
    y = round(b['y'] + b['height'] / 2)
    subprocess.run(['/opt/tools/click', str(x), str(y), str(button)],
                   capture_output=True, timeout=5, check=True)


def one(nodes, predicate, error):
    matches = [n for n in nodes if predicate(n)]
    if len(matches) != 1:
        raise ReplyError(error)
    return matches[0]


def get_text(chat_name):
    import gi
    gi.require_version('Atspi', '2.0')
    from gi.repository import Atspi
    Atspi.init()
    found = []
    def walk(node):
        try:
            if node.get_role_name() == 'text':
                states = node.get_state_set()
                if states.contains(Atspi.StateType.EDITABLE) and node.get_name() == chat_name:
                    found.append(node)
            for i in range(node.get_child_count()):
                walk(node.get_child_at_index(i))
        except Exception:
            pass
    walk(Atspi.get_desktop(0))
    if len(found) != 1:
        raise ReplyError('REPLY_EDITOR_UNAVAILABLE')
    return found[0].get_text_iface().get_text(0, -1)


def main(params):
    token = os.environ.get('AGENT_WECHAT_TOKEN') or Path('/data/auth-token').read_text().strip()
    def api(path):
        req = urllib.request.Request('http://127.0.0.1:' + os.environ.get('AGENT_PORT', '6174') + path,
                                     headers={'Authorization': 'Bearer ' + token})
        with urllib.request.urlopen(req, timeout=20) as result:
            return json.load(result)
    account = api('/api/status/auth').get('loggedInUser')
    if account != params['accountId']:
        raise ReplyError('REPLY_ACCOUNT_CHANGED')
    chats = []
    for offset in range(0, 10000, 200):
        page = api('/api/chats?limit=200&offset=' + str(offset))
        chats.extend(page)
        if len(page) < 200:
            break
    chat = one(chats, lambda c: c.get('id') == params['chatId'] and c.get('isGroup'),
               'REPLY_TARGET_UNAVAILABLE')
    if sum(c.get('name', '').casefold() == chat['name'].casefold() for c in chats) != 1:
        raise ReplyError('REPLY_TARGET_AMBIGUOUS')
    key_rows = query('/data/agent.db', "PRAGMA key='" + token.replace("'", "''") + "';",
                     "SELECT account_dir,db_name,hex_key FROM wechat_keys WHERE account_dir='" +
                     account.replace("'", "''") + "' AND db_name LIKE 'message_%.db' "
                     "AND db_name NOT LIKE '%fts%' AND db_name NOT LIKE '%resource%';")
    table = 'Msg_' + hashlib.md5(params['chatId'].encode()).hexdigest()
    rows = []; db_info = None
    for key in key_rows:
        for base in ['xwechat_files', 'Documents/xwechat_files']:
            path = Path('/home/wechat') / base / account / 'db_storage/message' / key['db_name']
            if not path.exists():
                continue
            pragmas = "PRAGMA key=\"x'" + key['hex_key'] + "'\"; PRAGMA cipher_compatibility=4;"
            try:
                values = query('file:' + str(path) + '?immutable=1', pragmas,
                               'SELECT local_id,server_id,(local_type & 2147483647) AS type,'
                               'hex(message_content) AS body,create_time FROM "' + table +
                               '" ORDER BY create_time,local_id;')
            except ReplyError:
                continue
            if values:
                rows = values; db_info = (path, pragmas); break
        if db_info:
            break
    if not db_info:
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    for row in rows:
        row['body'] = decode_body(row['body'])
    matches = [r for r in rows if str(r['server_id']) == params['sourceMessageId'] and r['server_id'] > 0]
    if not matches:
        matches = [r for r in rows if str(r['local_id']) == params['sourceMessageId'] and r['server_id'] == 0]
    if len(matches) != 1 or matches[0]['type'] != 1 or matches[0]['body'] != params['sourceText']:
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    source = matches[0]
    if source['server_id'] <= 0:
        raise ReplyError('REPLY_SOURCE_ID_UNAVAILABLE')
    # Get the exact sender display name from the Agent's original message lookup.
    source_wire = []
    for offset in range(0, len(rows) + 200, 200):
        page = api('/api/messages/' + urllib.parse.quote(params['chatId'], safe='') +
                   '?limit=200&offset=' + str(offset))
        source_wire += [r for r in page if r['localId'] == source['local_id']]
        if source_wire or len(page) < 200:
            break
    if len(source_wire) != 1 or str(source_wire[0]['serverId']) != str(source['server_id']):
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    sender_name = source_wire[0].get('senderName')
    if not sender_name:
        raise ReplyError('REPLY_SOURCE_SENDER_UNAVAILABLE')
    opened = subprocess.run(['/opt/tools/chat-select', '--chat-name', chat['name'], params['chatId']],
                            capture_output=True, text=True, timeout=45)
    if opened.returncode or not json.loads(opened.stdout).get('ok'):
        raise ReplyError('REPLY_TARGET_UNAVAILABLE')
    nodes = list(flatten(tree()))
    frame = one(nodes, lambda n: n.get('role') == 'frame' and n.get('name') in ['Weixin', 'WeChat'],
                'REPLY_WINDOW_UNAVAILABLE')
    b = frame['bounds']
    subprocess.run(['/opt/tools/window-activate', str(frame['window']['pid']),
                    *[str(b[k]) for k in ['x', 'y', 'width', 'height']]],
                   capture_output=True, timeout=8, check=True)
    if any(n.get('role') == 'invalid' and n.get('name', '').startswith('Quote ') for n in nodes):
        raise ReplyError('REPLY_EXISTING_DRAFT')
    if get_text(chat['name']).strip():
        raise ReplyError('REPLY_EXISTING_DRAFT')
    target = None
    for attempt in range(32):
        nodes = list(flatten(tree()))
        one(nodes, lambda n: n.get('role') == 'label' and n.get('name') == chat['name'],
            'REPLY_TARGET_CHANGED')
        messages = one(nodes, lambda n: n.get('role') == 'list' and n.get('name') == 'Messages',
                       'REPLY_MESSAGES_UNAVAILABLE')
        vb = messages['bounds']
        visible = [n for n in messages.get('children', []) if n.get('role') == 'list-item'
                   and n.get('bounds', {}).get('height', 0) > 0
                   and n['bounds']['y'] >= vb['y']
                   and n['bounds']['y'] + n['bounds']['height'] <= vb['y'] + vb['height']]
        target = source_node(rows, visible, source['local_id'])
        if target:
            break
        # Bound the search; unavailable history is never substituted with another message.
        x, y = round(vb['x'] + vb['width']/2), round(vb['y'] + vb['height']/2)
        subprocess.run(['xdotool', 'mousemove', str(x), str(y), 'click', '--repeat', '6', '4'],
                       capture_output=True, timeout=5, check=True)
        time.sleep(0.2)
    if not target:
        raise ReplyError('REPLY_SOURCE_NOT_VISIBLE')
    b = target['bounds']
    offset = b['width'] - 74 if source_wire[0].get('isSelf') else 74
    click(target, button=3, x_offset=offset)
    nodes = list(flatten(tree()))
    quote = one(nodes, lambda n: n.get('role') == 'menu-item' and n.get('name') == 'Quote',
                'REPLY_QUOTE_MENU_UNAVAILABLE')
    expected = "Quote " + sender_name + "'s message: " + source['body']
    generated = False
    dispatched = False
    preview = None
    try:
        click(quote)
        nodes = list(flatten(tree()))
        preview = one(nodes, lambda n: n.get('role') == 'invalid' and n.get('name') == expected,
                      'REPLY_QUOTE_PREVIEW_MISMATCH')
        subprocess.run(['/opt/tools/input', params['text']], capture_output=True, timeout=10, check=True)
        generated = True
        if get_text(chat['name']) != params['text']:
            raise ReplyError('REPLY_INPUT_MISMATCH')
        nodes = list(flatten(tree()))
        one(nodes, lambda n: n.get('role') == 'invalid' and n.get('name') == expected,
            'REPLY_QUOTE_PREVIEW_MISMATCH')
        one(nodes, lambda n: n.get('role') == 'label' and n.get('name') == chat['name'],
            'REPLY_TARGET_CHANGED')
        one(nodes, lambda n: n.get('role') == 'push-button' and n.get('name') in ['Send', 'Send(S)']
            and 'DISABLED' not in n.get('states', []), 'REPLY_SEND_UNAVAILABLE')
        before = max(r['local_id'] for r in rows)
        path, pragmas = db_info
        arrived = query('file:' + str(path) + '?immutable=1', pragmas,
                        'SELECT (local_type & 2147483647) AS type,hex(message_content) AS body '
                        'FROM "' + table + '" WHERE local_id>' + str(before) + ';')
        repeated = sum(r['type'] == 1 and r['body'] == source['body'] for r in rows) > 1
        if (arrived and repeated) or any(r['type'] == 1 and decode_body(r['body']) == source['body'] for r in arrived):
            raise ReplyError('REPLY_CHAT_CHANGED')
        if api('/api/status/auth').get('loggedInUser') != params['accountId']:
            raise ReplyError('REPLY_ACCOUNT_CHANGED')
        # Record intent before Return. Any exception afterwards has an unknown outcome.
        dispatched = True
        subprocess.run(['/opt/tools/key', 'Return'], capture_output=True, timeout=5, check=True)
        path, pragmas = db_info
        for _ in range(15):
            fresh = query('file:' + str(path) + '?immutable=1', pragmas,
                          'SELECT local_id,server_id,(local_type & 2147483647) AS type,'
                          'hex(message_content) AS body FROM "' + table + '" WHERE local_id>' +
                          str(before) + ' ORDER BY local_id;')
            valid = []
            for row in fresh:
                row['body'] = decode_body(row['body'])
                ref = reference(row['body'])
                if display_body(row) == params['text'] and ref and ref['svrid'] == str(source['server_id']):
                    valid.append(row)
            if len(valid) == 1 and valid[0]['server_id'] > 0:
                return {'success': True, 'status': 'succeeded',
                        'sourceServerId': str(source['server_id']),
                        'sentServerId': str(valid[0]['server_id']), 'sentLocalId': valid[0]['local_id']}
            if len(valid) > 1:
                raise ReplyError('REPLY_DUPLICATE_RESULT')
            time.sleep(1)
        raise ReplyError('REPLY_RESULT_UNKNOWN')
    except Exception as error:
        if dispatched:
            return {'success': False, 'status': 'unknown', 'errorCode': 'REPLY_RESULT_UNKNOWN'}
        if generated and get_text(chat['name']) == params['text']:
            subprocess.run(['/opt/tools/key', 'ctrl+a'], capture_output=True, timeout=5)
            subprocess.run(['/opt/tools/key', 'BackSpace'], capture_output=True, timeout=5)
        raise error
    finally:
        # Remove only the quote created by this operation, never an existing user draft.
        if not dispatched and preview:
            current = [n for n in flatten(tree()) if n.get("role") == "invalid" and n.get("name") == expected]
            buttons = [n for n in flatten(current[0] if len(current) == 1 else {}) if n.get('role') == 'push-button']
            if len(buttons) == 1:
                click(buttons[0])
            subprocess.run(['/opt/tools/key', 'Escape'], capture_output=True, timeout=5)


if __name__ == '__main__':
    os.umask(0o077)
    try:
        result = main(json.loads(Path(sys.argv[1]).read_text()))
    except ReplyError as error:
        result = {'success': False, 'status': 'failed', 'errorCode': str(error)}
    except Exception:
        result = {'success': False, 'status': 'failed', 'errorCode': 'REPLY_PREPARATION_FAILED'}
    print(json.dumps(result, ensure_ascii=False))
