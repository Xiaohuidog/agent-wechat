#!/usr/bin/env python3
"""Fail-closed WeChat image fetch helper used by the agent API."""

import argparse
import io
import json
import os
import pathlib
import re
import shutil
import subprocess
import tempfile
import time

from PIL import Image


class DownloadError(Exception):
    pass


def fail(code):
    print(json.dumps({"ok": False, "errorCode": code}))
    raise SystemExit(1)


def command(*args, timeout=15, check=True):
    name = os.path.basename(str(args[0])).upper().replace("-", "_")
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as error:
        raise DownloadError(f"{name}_TIMEOUT") from error
    if check and result.returncode != 0:
        try:
            payload = json.loads(result.stdout)
        except json.JSONDecodeError:
            payload = {}
        code = payload.get("errorCode") if isinstance(payload, dict) else None
        raise DownloadError(code or f"{name}_FAILED")
    return result


def walk(value):
    if isinstance(value, dict):
        yield value
        for child in value.get("children") or []:
            yield from walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from walk(child)


def tree():
    result = command("/opt/tools/a11y-dump", "--format", "json", timeout=10)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise DownloadError("A11Y_RESPONSE_INVALID") from error


def image_rows(value, geometry):
    safe_top = geometry["Y"] + 70
    safe_bottom = geometry["Y"] + geometry["HEIGHT"] - 105
    rows = []
    for node in walk(value):
        bounds = node.get("bounds") or {}
        try:
            x = float(bounds["x"])
            y = float(bounds["y"])
            width = float(bounds["width"])
            height = float(bounds["height"])
        except (KeyError, TypeError, ValueError):
            continue
        if (
            node.get("role") == "list-item"
            and str(node.get("name") or "").strip() == "Image"
            and width >= 500
            and height >= 60
            and x >= geometry["X"]
            and y >= safe_top
            and y + height <= safe_bottom
        ):
            rows.append(node)
    return rows


def image_click_point(row):
    bounds = row["bounds"]
    # Accessibility exposes the full chat-width row, while the image itself
    # is left-aligned inside it; clicking the row center misses the image.
    return {
        "x": round(float(bounds["x"]) + min(180, float(bounds["width"]) / 2)),
        "y": round(float(bounds["y"]) + float(bounds["height"]) / 2),
    }


def _normalized_difference(left, right):
    left = left.convert("RGB").resize((20, 20), Image.Resampling.BILINEAR)
    right = right.convert("RGB").resize((20, 20), Image.Resampling.BILINEAR)
    total = 0
    for a, b in zip(left.getdata(), right.getdata()):
        total += sum(abs(a[channel] - b[channel]) for channel in range(3))
    return total / (20 * 20 * 3 * 255)


def _best_row_match(screenshot, target, row):
    bounds = row["bounds"]
    left = max(0, round(float(bounds["x"]) + 48))
    top = max(0, round(float(bounds["y"]) + 3))
    right = min(screenshot.width, round(float(bounds["x"]) + float(bounds["width"]) - 8))
    bottom = min(screenshot.height, round(float(bounds["y"]) + float(bounds["height"]) - 3))
    ratio = target.width / target.height
    min_height = max(48, round((bottom - top) * 0.55))
    max_height = bottom - top
    best = None
    for height in range(min_height, max_height + 1, 4):
        width = max(32, round(height * ratio))
        if width > right - left:
            continue
        for y in range(top, bottom - height + 1, 4):
            for x in range(left, right - width + 1, 4):
                crop = screenshot.crop((x, y, x + width, y + height))
                score = _normalized_difference(crop, target)
                if best is None or score < best[0]:
                    best = (score, x, y, width, height)
    return best


def find_unique_match(screenshot, target, rows, threshold=0.18):
    matches = []
    for row in rows:
        bounds = row.get("bounds") or {}
        try:
            y = float(bounds["y"])
            height = float(bounds["height"])
        except (KeyError, TypeError, ValueError):
            continue
        if y < 0 or height < 60 or y + height > screenshot.height:
            continue
        best = _best_row_match(screenshot, target, row)
        if best is not None and best[0] <= threshold:
            score, x, top, width, match_height = best
            matches.append(
                {
                    "score": score,
                    "x": x + width // 2,
                    "y": top + match_height // 2,
                    "row": row,
                }
            )
    if not matches:
        raise DownloadError("IMAGE_CARD_NOT_FOUND")
    if len(matches) != 1:
        raise DownloadError("IMAGE_IDENTITY_AMBIGUOUS")
    match = matches[0]
    newest_y = max(float((row.get("bounds") or {}).get("y", -1)) for row in rows)
    if float(match["row"]["bounds"]["y"]) != newest_y:
        raise DownloadError("IMAGE_NOT_NEWEST_VISIBLE_MESSAGE")
    return match


def weixin_geometry():
    result = command("xdotool", "search", "--onlyvisible", "--name", "^Weixin$")
    ids = [value for value in result.stdout.splitlines() if value.isdigit()]
    candidates = []
    for window_id in ids:
        result = command("xdotool", "getwindowgeometry", "--shell", window_id, check=False)
        values = {}
        for line in result.stdout.splitlines():
            key, separator, value = line.partition("=")
            if separator and key in {"X", "Y", "WIDTH", "HEIGHT"} and value.lstrip("-").isdigit():
                values[key] = int(value)
        if set(values) == {"X", "Y", "WIDTH", "HEIGHT"}:
            candidates.append((values["WIDTH"] * values["HEIGHT"], window_id, values))
    if not candidates:
        raise DownloadError("WEIXIN_WINDOW_GEOMETRY_INVALID")
    _area, window_id, values = max(candidates, key=lambda item: item[0])
    if values["WIDTH"] < 700 or values["HEIGHT"] < 500:
        raise DownloadError("WEIXIN_WINDOW_TOO_SMALL")
    command("xdotool", "windowactivate", "--sync", window_id)
    if command("xdotool", "getactivewindow").stdout.strip() != window_id:
        raise DownloadError("WEIXIN_WINDOW_NOT_ACTIVE")
    return values


def capture():
    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as output:
        path = output.name
    try:
        command("scrot", "-o", path, timeout=10)
        with Image.open(path) as image:
            return image.convert("RGB")
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


def publish_saved_image(source, preview_path):
    source = pathlib.Path(source)
    preview_path = pathlib.Path(preview_path)
    os.replace(source, preview_path)
    # The running agent resolves <hash>_h.dat to <hash>_h_preview.jpg.
    high_resolution_preview = preview_path.with_name(
        preview_path.name.removesuffix("_preview.jpg") + "_h_preview.jpg"
    )
    link_path = high_resolution_preview.with_name(high_resolution_preview.name + ".new")
    link_path.unlink(missing_ok=True)
    os.link(preview_path, link_path)
    os.replace(link_path, high_resolution_preview)


def native_image_path(image_dir, stem):
    match = re.fullmatch(
        r"(?P<account>/home/wechat(?:/Documents)?/xwechat_files/[^/]+)/msg/attach/[0-9a-f]{32}/\d{4}-\d{2}/Img",
        str(image_dir),
    )
    if match is None or re.fullmatch(r"[0-9a-f]{32}", stem) is None:
        raise DownloadError("IMAGE_TARGET_PATH_INVALID")
    return pathlib.Path(match.group("account")) / "temp" / "ImageUtils" / f"{stem}_h.jpg"


def native_image_size(path, timeout_seconds=20):
    deadline = time.monotonic() + timeout_seconds
    while True:
        try:
            with Image.open(path) as image:
                image.verify()
            size = path.stat().st_size
            if size > 0:
                return size
        except (FileNotFoundError, OSError):
            pass
        if time.monotonic() >= deadline:
            raise DownloadError("IMAGE_NATIVE_DECODE_MISSING")
        time.sleep(0.2)


def publish_native_image(native_path, image_dir, stem, local_id, preview_path, timeout_seconds=0):
    if native_path.name != f"{stem}_h.jpg":
        raise DownloadError("IMAGE_IDENTITY_MISMATCH")
    size = native_image_size(native_path, timeout_seconds=timeout_seconds)
    export_path = image_dir / f"{stem}_export_{local_id}.jpg"
    shutil.copyfile(native_path, export_path)
    publish_saved_image(export_path, preview_path)
    return size


def selected_chat(value, chat_name):
    return any(
        item.get("role") == "list-item"
        and "SELECTED" in (item.get("states") or [])
        and (
            item.get("name") == chat_name
            or str(item.get("name") or "").startswith(chat_name + " ")
        )
        for item in walk(value)
    )


def unique_chat_item(value, chat_name):
    matches = [
        item for item in walk(value)
        if item.get("role") == "list-item"
        and isinstance(item.get("name"), str)
        and (item["name"] == chat_name or item["name"].startswith(chat_name + " "))
        and item.get("bounds")
    ]
    if len(matches) > 1:
        raise DownloadError("CHAT_IDENTITY_AMBIGUOUS")
    if not matches:
        raise DownloadError("CHAT_UI_NOT_FOUND")
    return matches[0]


def select_chat(chat_name):
    current = tree()
    if selected_chat(current, chat_name):
        return
    item = unique_chat_item(current, chat_name)
    bounds = item["bounds"]
    x = round(float(bounds["x"]) + float(bounds["width"]) / 2)
    y = round(float(bounds["y"]) + float(bounds["height"]) / 2)
    command("xdotool", "mousemove", str(x), str(y), "click", "1")
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        if selected_chat(tree(), chat_name):
            return
        time.sleep(0.4)
    raise DownloadError("CHAT_UI_SELECT_UNCONFIRMED")


def publish_clipboard_image(data, preview_path):
    preview_path = pathlib.Path(preview_path)
    try:
        with Image.open(io.BytesIO(data)) as source:
            source.load()
            if source.format != "PNG" or min(source.size) < 2:
                raise DownloadError("IMAGE_CLIPBOARD_INVALID")
            image = source.convert("RGB")
    except (OSError, ValueError) as error:
        raise DownloadError("IMAGE_CLIPBOARD_INVALID") from error
    with tempfile.NamedTemporaryFile(dir=preview_path.parent, suffix=".jpg", delete=False) as output:
        temporary = pathlib.Path(output.name)
    try:
        image.save(temporary, "JPEG", quality=95, subsampling=0)
        size = temporary.stat().st_size
        publish_saved_image(temporary, preview_path)
        return size
    finally:
        temporary.unlink(missing_ok=True)


def copy_viewer_image(preview_path):
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        active = command("xdotool", "getactivewindow", "getwindowname", check=False)
        if active.stdout.strip() == "Photos and Videos":
            break
        time.sleep(0.3)
    else:
        raise DownloadError("IMAGE_VIEWER_NOT_OPEN")
    command("xdotool", "key", "--clearmodifiers", "ctrl+c")
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        copied = subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", "image/png", "-o"],
            capture_output=True, timeout=5,
        )
        if copied.returncode == 0 and copied.stdout:
            return publish_clipboard_image(copied.stdout, preview_path)
        time.sleep(0.3)
    raise DownloadError("IMAGE_CLIPBOARD_UNAVAILABLE")


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("--chat-id", required=True)
    parser.add_argument("--chat-name", required=True)
    parser.add_argument("--local-id", required=True, type=int)
    parser.add_argument("--thumbnail")
    parser.add_argument("--preview-path", required=True)
    parser.add_argument("--image-dir", required=True)
    parser.add_argument("--stem", required=True)
    return parser.parse_args()


def main():
    args = parse_args()
    image_dir = pathlib.Path(args.image_dir)
    valid_stem = re.fullmatch(r"[0-9a-f]{32}", args.stem) is not None
    valid_image_dir = re.fullmatch(
        r"/home/wechat(?:/Documents)?/xwechat_files/[^/]+/msg/attach/[0-9a-f]{32}/\d{4}-\d{2}/Img",
        str(image_dir),
    ) is not None
    valid_thumbnail = args.thumbnail is None or re.fullmatch(
        r"/tmp/agent-image-[0-9a-f-]+\.jpg", args.thumbnail
    ) is not None
    valid_preview = re.fullmatch(
        r"/home/wechat(?:/Documents)?/xwechat_files/[^/]+/msg/attach/[0-9a-f]{32}/\d{4}-\d{2}/Img/[0-9a-f]{32}_preview\.jpg",
        args.preview_path,
    ) is not None
    if not (valid_stem and valid_image_dir and valid_thumbnail and valid_preview):
        fail("IMAGE_TARGET_PATH_INVALID")
    if pathlib.Path(args.preview_path) != image_dir / f"{args.stem}_preview.jpg":
        fail("IMAGE_TARGET_PATH_INVALID")
    try:
        native_path = native_image_path(image_dir, args.stem)
        variant = "wechat-native-cache"
        if native_path.is_file():
            size = publish_native_image(native_path, image_dir, args.stem, args.local_id, args.preview_path)
            print(json.dumps({"ok": True, "sizeBytes": size, "variant": "wechat-native-cache"}))
            return
        geometry = weixin_geometry()
        select_chat(args.chat_name)
        time.sleep(1)
        # The database gate guarantees this is the newest message. Move the
        # message view to its end, then require a unique visual identity match.
        scroll_x = round(geometry["X"] + geometry["WIDTH"] * 0.72)
        scroll_y = round(geometry["Y"] + geometry["HEIGHT"] * 0.50)
        command("xdotool", "mousemove", str(scroll_x), str(scroll_y), "click", "--repeat", "10", "--delay", "50", "5")
        time.sleep(0.8)
        current_tree = tree()
        rows = image_rows(current_tree, geometry)
        if args.thumbnail:
            screenshot = capture()
            with Image.open(args.thumbnail) as target_image:
                match = find_unique_match(screenshot, target_image.convert("RGB"), rows)
        else:
            if not rows:
                raise DownloadError("IMAGE_CARD_NOT_FOUND")
            row = max(rows, key=lambda value: float(value["bounds"]["y"]))
            match = image_click_point(row)
        cleared = subprocess.run(
            ["xclip", "-selection", "clipboard", "-i"],
            input=b"GROUPBOT_IMAGE_CLIPBOARD_SENTINEL",
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
        if cleared.returncode != 0:
            raise DownloadError("IMAGE_CLIPBOARD_CLEAR_FAILED")
        command("xdotool", "mousemove", str(match["x"]), str(match["y"]), "click", "1")
        try:
            try:
                size = publish_native_image(
                    native_path, image_dir, args.stem, args.local_id,
                    args.preview_path, timeout_seconds=0,
                )
            except DownloadError as error:
                if str(error) != "IMAGE_NATIVE_DECODE_MISSING":
                    raise
                size = copy_viewer_image(args.preview_path)
                variant = "viewer-clipboard"
        finally:
            command("xdotool", "key", "--clearmodifiers", "Escape", check=False)
    except (DownloadError, json.JSONDecodeError) as error:
        fail(str(error) if isinstance(error, DownloadError) else "CHAT_OPEN_RESPONSE_INVALID")

    print(json.dumps({"ok": True, "sizeBytes": size, "variant": variant}))


if __name__ == "__main__":
    main()
