#!/usr/bin/env python3
"""Native WeChat quote sending. Source IDs are strings; uncertain sends never repeat."""
import ctypes
import ctypes.util
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET


class ReplyError(Exception):
    pass


def query(path, pragmas, sql):
    result = subprocess.run(['sqlcipher', '-readonly', str(path)],
                            input='.mode json\n' + pragmas + '\n' + sql + '\n',
                            text=True, capture_output=True, timeout=25)
    if result.returncode:
        raise ReplyError('REPLY_SOURCE_READ_FAILED')
    output = result.stdout.strip()
    groups = []
    while '[' in output:
        start = output.index('[')
        value, used = json.JSONDecoder().raw_decode(output[start:])
        groups.append(value)
        output = output[start + used:].lstrip()
    return [r for r in (groups[-1] if groups else []) if 'ok' not in r]


def decode_body(value):
    data = bytes.fromhex(value)
    if data.startswith(bytes.fromhex('28b52ffd')):
        lib = ctypes.CDLL(ctypes.util.find_library('zstd'))
        lib.ZSTD_getFrameContentSize.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
        lib.ZSTD_getFrameContentSize.restype = ctypes.c_ulonglong
        size = lib.ZSTD_getFrameContentSize(data, len(data))
        if not 0 < size <= 2_000_000:
            raise ReplyError('REPLY_SOURCE_FORMAT_UNSUPPORTED')
        dest = ctypes.create_string_buffer(size)
        lib.ZSTD_decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t,
                                      ctypes.c_void_p, ctypes.c_size_t]
        lib.ZSTD_decompress.restype = ctypes.c_size_t
        n = lib.ZSTD_decompress(dest, size, data, len(data))
        if n > size:
            raise ReplyError('REPLY_SOURCE_FORMAT_UNSUPPORTED')
        data = dest.raw[:n]
    body = data.decode('utf-8', errors='replace')
    return re.sub(r'^[^\n]+:\n', '', body, count=1)


def reference(body):
    match = re.search(r'<refermsg>.*?</refermsg>', body, re.S)
    if not match:
        return None
    root = ET.fromstring(match.group())
    return {k: root.findtext(k) for k in ['svrid', 'content', 'type']}


def display_body(row):
    body = row['body']
    if row['type'] == 1:
        return body
    if row['type'] == 49:
        try:
            root = ET.fromstring(body[body.index('<'):])
            return root.findtext('.//appmsg/title') or root.findtext('title')
        except (ValueError, ET.ParseError):
            return None
    return None


def source_kind_supported(row, kind):
    allowed = {'text': {1, 49}, 'baidu_link': {1, 49}, 'image': {3},
               'voice': {34}, 'video': {43, 62}, 'sticker': {47},
               'file': {49}, 'mini_program': {49}, 'video_channel': {49}}
    if row['type'] not in allowed.get(kind, set()):
        return False
    if row['type'] != 49:
        return True
    try:
        root = ET.fromstring(row['body'][row['body'].index('<'):])
        subtype = root.findtext('.//appmsg/type')
    except (ValueError, ET.ParseError):
        return False
    subtype_sets = {'text': {'3', '4', '5', '57'}, 'baidu_link': {'3', '4', '5', '57'},
                    'file': {'6'}, 'mini_program': {'33', '36'}, 'video_channel': {'51'}}
    return subtype in subtype_sets.get(kind, set())


def reference_caption(ref):
    labels = {'3': 'Image', '34': 'Voice message', '43': 'Video', '62': 'Video', '47': 'Sticker'}
    if ref.get('type') in labels:
        return labels[ref['type']]
    content = ref.get('content') or ''
    if ref.get('type') == '49' and '<appmsg' in content:
        try:
            return ET.fromstring(content[content.index('<'):]).findtext('.//appmsg/title') or content
        except (ValueError, ET.ParseError):
            pass
    return content


def system_display_text(body):
    try:
        root = ET.fromstring(body[body.index('<'):])
        content = root.find('.//sysmsgtemplate/content_template')
        if content is None:
            return None
        plain = content.findtext('plain')
        if plain:
            return plain
        template = content.findtext('template')
        if not template:
            return None
        replacements = {}
        for link in content.findall('link_list/link'):
            key = link.get('name')
            if not key or key in replacements:
                return None
            value = link.findtext('plain')
            if value is None:
                members = link.findall('memberlist/member')
                names = [member.findtext('nickname') for member in members]
                separator = link.findtext('separator')
                if not names or any(name is None for name in names) or (len(names) > 1 and separator is None):
                    return None
                value = (separator or '').join(names)
            replacements[key] = value
        keys = re.findall(r'\$([^$]+)\$', template)
        if any(key not in replacements for key in keys):
            return None
        return re.sub(r'\$([^$]+)\$', lambda match: replacements[match[1]], template)
    except (ValueError, ET.ParseError):
        return None


def row_matches(row, name):
    if row['type'] == 10000:
        return system_display_text(row['body']) == name
    if row['type'] == 49 and not reference(row['body']):
        try:
            root = ET.fromstring(row['body'][row['body'].index('<'):])
            app = root if root.tag == 'appmsg' else root.find('.//appmsg')
            if app is not None and app.findtext('type') == '51':
                author = app.findtext('finderFeed/nickname')
                return bool(author) and name == 'Channels' + author
        except (ValueError, ET.ParseError):
            return False
    expected = display_body(row)
    if row['type'] == 1:
        return name == expected
    if row['type'] == 49:
        ref = reference(row['body'])
        if ref:
            caption = reference_caption(ref)
            return name.startswith((expected or '') + '\nQuote ') and name.casefold().endswith(
                "'s message: " + caption.casefold())
        return bool(expected and expected in name)
    names = {3: ('image', '图片'), 34: ('voice', 'audio', '语音'), 43: ('video', '视频'),
             62: ('video', '视频'), 47: ('sticker', 'emoji', '表情')}
    return '\nQuote ' not in name and any(label in name.casefold() for label in names.get(row['type'], ()))


def message_nodes(messages):
    # Qt exposes time separators as list-items too; they are not database message rows.
    bounds = messages['bounds']
    time_label = re.compile(r'^(?:\d{1,2}:\d{2}|(?:Today|Yesterday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\b.*|\d{4}[-/]\d{1,2}[-/]\d{1,2}.*)$')
    return [n for n in messages.get('children', []) if n.get('role') == 'list-item'
            and n.get('bounds', {}).get('height', 0) > 0
            # Partly visible rows are still identity anchors for adjacent media.
            and n['bounds']['y'] < bounds['y'] + bounds['height']
            and n['bounds']['y'] + n['bounds']['height'] > bounds['y']
            and not (n['bounds']['height'] <= 45 and time_label.fullmatch(n.get('name', '')))]


def clickable_target(target, messages):
    if target is None:
        return None
    box, viewport = target['bounds'], messages['bounds']
    left = max(box['x'], viewport['x'] + 4)
    right = min(box['x'] + box['width'], viewport['x'] + viewport['width'] - 4)
    top = max(box['y'], viewport['y'] + 4)
    bottom = min(box['y'] + box['height'], viewport['y'] + viewport['height'] - 4)
    # The source identity is already verified. Keep both the bubble-side offset
    # and the vertical click inside this source's visible interior.
    if right - left < 160 or bottom - top < 40:
        return None
    return {**target, 'bounds': {'x': left, 'y': top,
                               'width': right - left, 'height': bottom - top}}


def source_node(rows, visible, local_id):
    """Accept a unique text identity or unique ordered mapping of the visible message rows."""
    source = next(r for r in rows if r['local_id'] == local_id)
    candidates = [i for i, n in enumerate(visible) if row_matches(source, n['name'])]
    if not candidates:
        return None
    caption = display_body(source)
    # Media labels repeat; they always require ordered context, never label-only selection.
    if caption is not None and sum(display_body(r) == caption for r in rows) == 1:
        return visible[candidates[0]] if len(candidates) == 1 else None
    placements = [start for start in range(len(rows) - len(visible) + 1)
                  if all(row_matches(rows[start + i], n['name']) for i, n in enumerate(visible))]
    if len(placements) != 1:
        raise ReplyError('REPLY_SOURCE_AMBIGUOUS')
    offset = next(i for i, r in enumerate(rows) if r['local_id'] == local_id) - placements[0]
    if 0 <= offset < len(visible) and offset in candidates:
        return visible[offset]
    return None


def flatten(node):
    yield node
    for child in node.get('children', []):
        yield from flatten(child)


def chat_ready(nodes, name):
    # Reuse only a uniquely verified chat with its own editable input and message list.
    required = [('label', name), ('list', 'Messages')]
    if any(sum(n.get('role') == role and n.get('name') == value for n in nodes) != 1
           for role, value in required):
        return False
    editors = [n for n in nodes if n.get('role') == 'text' and n.get('name') == name
               and 'EDITABLE' in (n.get('states') or [])]
    frames = [n for n in nodes if n.get('role') == 'frame' and n.get('name') in ['Weixin', 'WeChat']]
    return len(editors) == 1 and len(frames) == 1


def require_target(nodes, name, client_pid):
    frames = [n for n in nodes if n.get('role') == 'frame'
              and n.get('name') in ['Weixin', 'WeChat']]
    if len(frames) != 1:
        raise ReplyError('REPLY_CLIENT_UNAVAILABLE')
    if frames[0].get('window', {}).get('pid') != client_pid:
        raise ReplyError('REPLY_CLIENT_RESTARTED')
    one(nodes, lambda n: n.get('role') == 'label' and n.get('name') == name,
        'REPLY_TARGET_CHANGED')


def wait_for_quote(chat_name, client_pid):
    for attempt in range(4):
        nodes = list(flatten(tree()))
        require_target(nodes, chat_name, client_pid)
        matches = [n for n in nodes if n.get('role') == 'menu-item' and n.get('name') == 'Quote']
        if len(matches) > 1:
            raise ReplyError('REPLY_QUOTE_MENU_UNAVAILABLE')
        if len(matches) == 1 and 'DISABLED' not in (matches[0].get('states') or []):
            return matches[0]
        if attempt < 3:
            time.sleep(0.2)
    raise ReplyError('REPLY_QUOTE_MENU_UNAVAILABLE')


def locate_source(rows, local_id, chat_name, client_pid):
    def snapshot():
        nodes = list(flatten(tree()))
        require_target(nodes, chat_name, client_pid)
        messages = one(nodes, lambda n: n.get('role') == 'list' and n.get('name') == 'Messages',
                       'REPLY_MESSAGES_UNAVAILABLE')
        visible = message_nodes(messages)
        source = source_node(rows, visible, local_id)
        target = clickable_target(source, messages)
        signature = tuple((n.get('name'), tuple(sorted(n.get('bounds', {}).items()))) for n in visible)
        return messages, target, signature, source

    def scroll(messages, button, count):
        bounds = messages['bounds']
        subprocess.run(['xdotool', 'mousemove', str(round(bounds['x'] + bounds['width']/2)),
                        str(round(bounds['y'] + bounds['height']/2)), 'click',
                        '--repeat', count, '--delay', '80', button],
                       capture_output=True, timeout=5, check=True)
        time.sleep(0.2)

    def align(state):
        for _ in range(4):
            messages, target, signature, source = state
            if target or source is None:
                return state
            button = '4' if source['bounds']['y'] < messages['bounds']['y'] else '5'
            scroll(messages, button, '1')
            state = snapshot()
        return state

    messages, target, signature, source = align(snapshot())
    if target:
        return target
    # Inspect the current viewport first, then recent and older history in paced
    # batches. An identified partial source is aligned, never blindly skipped.
    for button, count, attempts in [('5', '12', 8), ('4', '6', 32)]:
        for _ in range(attempts):
            scroll(messages, button, count)
            messages, target, current, source = align(snapshot())
            if target:
                return target
            if current == signature:
                break
            signature = current
    return None


def quote_cancel_button(root, expected):
    # Media previews contain a clickable thumbnail. The cancel control is its sibling.
    for parent in flatten(root):
        previews = [n for n in parent.get('children', [])
                    if n.get('role') == 'invalid' and n.get('name') == expected]
        if len(previews) != 1:
            continue
        b = previews[0]['bounds']
        buttons = {}
        for n in flatten(parent):
            nb = n.get('bounds') or {}
            if (n.get('role') == 'push-button' and nb.get('x', -1) >= b['x'] + b['width']
                    and b['y'] <= nb.get('y', -1) < b['y'] + b['height']):
                buttons[tuple(nb[k] for k in ['x', 'y', 'width', 'height'])] = n
        if len(buttons) == 1:
            return next(iter(buttons.values()))
    return None


def tree():
    result = subprocess.run(['/opt/tools/a11y-dump'], capture_output=True,
                            text=True, timeout=20, check=True)
    return json.loads(result.stdout)


def click(node, button=1, x_offset=None):
    b = node['bounds']
    x = round(b['x'] + (b['width'] / 2 if x_offset is None else x_offset))
    y = round(b['y'] + b['height'] / 2)
    subprocess.run(['/opt/tools/click', str(x), str(y), str(button)],
                   capture_output=True, timeout=5, check=True)


def one(nodes, predicate, error):
    matches = [n for n in nodes if predicate(n)]
    if len(matches) != 1:
        raise ReplyError(error)
    return matches[0]


def get_text(chat_name):
    import gi
    gi.require_version('Atspi', '2.0')
    from gi.repository import Atspi
    Atspi.init()
    found = []
    def walk(node):
        try:
            if node.get_role_name() == 'text':
                states = node.get_state_set()
                if states.contains(Atspi.StateType.EDITABLE) and node.get_name() == chat_name:
                    found.append(node)
            for i in range(node.get_child_count()):
                walk(node.get_child_at_index(i))
        except Exception:
            pass
    walk(Atspi.get_desktop(0))
    if len(found) != 1:
        raise ReplyError('REPLY_EDITOR_UNAVAILABLE')
    return found[0].get_text_iface().get_text(0, -1)


def main(params):
    token = os.environ.get('AGENT_WECHAT_TOKEN') or Path('/data/auth-token').read_text().strip()
    def api(path):
        req = urllib.request.Request('http://127.0.0.1:' + os.environ.get('AGENT_PORT', '6174') + path,
                                     headers={'Authorization': 'Bearer ' + token})
        with urllib.request.urlopen(req, timeout=20) as result:
            return json.load(result)
    account = api('/api/status/auth').get('loggedInUser')
    if account != params['accountId']:
        raise ReplyError('REPLY_ACCOUNT_CHANGED')
    chats = []
    for offset in range(0, 10000, 200):
        page = api('/api/chats?limit=200&offset=' + str(offset))
        chats.extend(page)
        if len(page) < 200:
            break
    chat = one(chats, lambda c: c.get('id') == params['chatId'] and c.get('isGroup'),
               'REPLY_TARGET_UNAVAILABLE')
    if sum(c.get('name', '').casefold() == chat['name'].casefold() for c in chats) != 1:
        raise ReplyError('REPLY_TARGET_AMBIGUOUS')
    key_rows = query('/data/agent.db', "PRAGMA key='" + token.replace("'", "''") + "';",
                     "SELECT account_dir,db_name,hex_key FROM wechat_keys WHERE account_dir='" +
                     account.replace("'", "''") + "' AND db_name LIKE 'message_%.db' "
                     "AND db_name NOT LIKE '%fts%' AND db_name NOT LIKE '%resource%';")
    table = 'Msg_' + hashlib.md5(params['chatId'].encode()).hexdigest()
    rows = []; db_info = None
    for key in key_rows:
        for base in ['xwechat_files', 'Documents/xwechat_files']:
            path = Path('/home/wechat') / base / account / 'db_storage/message' / key['db_name']
            if not path.exists():
                continue
            pragmas = "PRAGMA key=\"x'" + key['hex_key'] + "'\"; PRAGMA cipher_compatibility=4;"
            try:
                values = query('file:' + str(path) + '?immutable=1', pragmas,
                               'SELECT local_id,server_id,(local_type & 2147483647) AS type,'
                               'hex(message_content) AS body,create_time FROM "' + table +
                               '" ORDER BY create_time,local_id;')
            except ReplyError:
                continue
            if values:
                rows = values; db_info = (path, pragmas); break
        if db_info:
            break
    if not db_info:
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    for row in rows:
        row['body'] = decode_body(row['body'])
    matches = [r for r in rows if str(r['server_id']) == params['sourceMessageId'] and r['server_id'] > 0]
    if not matches:
        matches = [r for r in rows if str(r['local_id']) == params['sourceMessageId'] and r['server_id'] == 0]
    if len(matches) != 1:
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    source = matches[0]
    kind = params.get('sourceKind', 'text')
    if not source_kind_supported(source, kind) or (source['type'] == 1 and kind == 'text' and source['body'] != params['sourceText']):
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    source = matches[0]
    if source['server_id'] <= 0:
        raise ReplyError('REPLY_SOURCE_ID_UNAVAILABLE')
    # Get the exact sender display name from the Agent's original message lookup.
    source_wire = []
    for offset in range(0, len(rows) + 200, 200):
        page = api('/api/messages/' + urllib.parse.quote(params['chatId'], safe='') +
                   '?limit=200&offset=' + str(offset))
        source_wire += [r for r in page if r['localId'] == source['local_id']]
        if source_wire or len(page) < 200:
            break
    if len(source_wire) != 1 or str(source_wire[0]['serverId']) != str(source['server_id']):
        raise ReplyError('REPLY_SOURCE_UNAVAILABLE')
    sender_name = source_wire[0].get('senderName')
    if not sender_name:
        raise ReplyError('REPLY_SOURCE_SENDER_UNAVAILABLE')
    nodes = list(flatten(tree()))
    if not chat_ready(nodes, chat['name']):
        opened = subprocess.run(['/opt/tools/chat-select', '--chat-name', chat['name'], params['chatId']],
                                capture_output=True, text=True, timeout=45)
        if opened.returncode or not json.loads(opened.stdout).get('ok'):
            raise ReplyError('REPLY_TARGET_UNAVAILABLE')
        nodes = list(flatten(tree()))
    frame = one(nodes, lambda n: n.get('role') == 'frame' and n.get('name') in ['Weixin', 'WeChat'],
                'REPLY_WINDOW_UNAVAILABLE')
    b = frame['bounds']
    subprocess.run(['/opt/tools/window-activate', str(frame['window']['pid']),
                    *[str(b[k]) for k in ['x', 'y', 'width', 'height']]],
                   capture_output=True, timeout=8, check=True)
    if any(n.get('role') == 'invalid' and n.get('name', '').startswith('Quote ') for n in nodes):
        raise ReplyError('REPLY_EXISTING_DRAFT')
    if get_text(chat['name']).strip():
        raise ReplyError('REPLY_EXISTING_DRAFT')
    client_pid = frame['window']['pid']
    target = locate_source(rows, source['local_id'], chat['name'], client_pid)
    if not target:
        raise ReplyError('REPLY_SOURCE_NOT_VISIBLE')
    b = target['bounds']
    offset = b['width'] - 74 if source_wire[0].get('isSelf') else 74
    click(target, button=3, x_offset=offset)
    try:
        quote = wait_for_quote(chat['name'], client_pid)
    except ReplyError:
        subprocess.run(['/opt/tools/key', 'Escape'], capture_output=True, timeout=5)
        raise
    prefix = "Quote " + sender_name + "'s message: "
    expected = None
    caption = display_body(source)
    if source['type'] == 1 or (source['type'] == 49 and reference(source['body'])):
        expected = prefix + (caption or '')
    generated = False
    dispatched = False
    preview = None
    try:
        click(quote)
        nodes = list(flatten(tree()))
        preview = one(nodes, lambda n: n.get('role') == 'invalid'
                      and (n.get('name') == expected if expected is not None else n.get('name', '').startswith(prefix)),
                      'REPLY_QUOTE_PREVIEW_MISMATCH')
        expected = preview['name']
        if params.get('previewOnly') is True:
            return {'success': True, 'status': 'validated', 'sourceKind': kind,
                    'sourceServerId': str(source['server_id'])}
        subprocess.run(['/opt/tools/input', params['text']], capture_output=True, timeout=10, check=True)
        generated = True
        if get_text(chat['name']) != params['text']:
            raise ReplyError('REPLY_INPUT_MISMATCH')
        nodes = list(flatten(tree()))
        one(nodes, lambda n: n.get('role') == 'invalid' and n.get('name') == expected,
            'REPLY_QUOTE_PREVIEW_MISMATCH')
        require_target(nodes, chat['name'], client_pid)
        one(nodes, lambda n: n.get('role') == 'push-button' and n.get('name') in ['Send', 'Send(S)']
            and 'DISABLED' not in n.get('states', []), 'REPLY_SEND_UNAVAILABLE')
        before = max(r['local_id'] for r in rows)
        path, pragmas = db_info
        arrived = query('file:' + str(path) + '?immutable=1', pragmas,
                        'SELECT (local_type & 2147483647) AS type,hex(message_content) AS body '
                        'FROM "' + table + '" WHERE local_id>' + str(before) + ';')
        repeated = caption is None or sum(display_body(r) == caption for r in rows) > 1
        if (arrived and repeated) or any(display_body({**r, 'body': decode_body(r['body'])}) == display_body(source) for r in arrived):
            raise ReplyError('REPLY_CHAT_CHANGED')
        if api('/api/status/auth').get('loggedInUser') != params['accountId']:
            raise ReplyError('REPLY_ACCOUNT_CHANGED')
        # Record intent before Return. Any exception afterwards has an unknown outcome.
        dispatched = True
        subprocess.run(['/opt/tools/key', 'Return'], capture_output=True, timeout=5, check=True)
        path, pragmas = db_info
        for _ in range(15):
            fresh = query('file:' + str(path) + '?immutable=1', pragmas,
                          'SELECT local_id,server_id,(local_type & 2147483647) AS type,'
                          'hex(message_content) AS body FROM "' + table + '" WHERE local_id>' +
                          str(before) + ' ORDER BY local_id;')
            valid = []
            for row in fresh:
                row['body'] = decode_body(row['body'])
                ref = reference(row['body'])
                if display_body(row) == params['text'] and ref and ref['svrid'] == str(source['server_id']):
                    valid.append(row)
            if len(valid) == 1 and valid[0]['server_id'] > 0:
                return {'success': True, 'status': 'succeeded', 'sourceKind': kind,
                        'sourceServerId': str(source['server_id']),
                        'sentServerId': str(valid[0]['server_id']), 'sentLocalId': valid[0]['local_id']}
            if len(valid) > 1:
                raise ReplyError('REPLY_DUPLICATE_RESULT')
            time.sleep(1)
        raise ReplyError('REPLY_RESULT_UNKNOWN')
    except Exception as error:
        if dispatched:
            return {'success': False, 'status': 'unknown', 'errorCode': 'REPLY_RESULT_UNKNOWN'}
        if generated and get_text(chat['name']) == params['text']:
            subprocess.run(['/opt/tools/key', 'ctrl+a'], capture_output=True, timeout=5)
            subprocess.run(['/opt/tools/key', 'BackSpace'], capture_output=True, timeout=5)
        raise error
    finally:
        # Remove only the quote created by this operation, never an existing user draft.
        if not dispatched and preview:
            cancel = quote_cancel_button(tree(), expected)
            if cancel:
                click(cancel)
            if any(n.get('role') == 'invalid' and n.get('name') == expected for n in flatten(tree())):
                raise ReplyError('REPLY_QUOTE_CLEANUP_FAILED')


if __name__ == '__main__':
    os.umask(0o077)
    try:
        result = main(json.loads(Path(sys.argv[1]).read_text()))
    except ReplyError as error:
        result = {'success': False, 'status': 'failed', 'errorCode': str(error)}
    except Exception:
        result = {'success': False, 'status': 'failed', 'errorCode': 'REPLY_PREPARATION_FAILED'}
    print(json.dumps(result, ensure_ascii=False))
